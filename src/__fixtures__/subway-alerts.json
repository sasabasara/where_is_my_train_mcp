        ],
        "header_text": {
          "translation": [
            {
              "text": "No [2][5] between Franklin Av-Medgar Evers College and Flatbush Av-Brooklyn College in both directions.\n[2][5] trains are running with delays in both directions.",
              "language": "en"
            },
            {
              "text": "<p>No [2][5] between <strong>Franklin Av-Medgar Evers College</strong> and <strong>Flatbush Av-Brooklyn College</strong> in both directions.</p><p>[2][5] trains are running with delays in both directions.</p>",
              "language": "en-html"
            }
          ]
        },
        "description_text": {
          "translation": [
            {
              "text": "What's Happening?\nEmergency teams are responding to someone struck by a train at Winthrop St.\n\nService Changes:\nNo [2][5] service between Franklin Av and Flatbush Av.\nFlatbush Av-bound [2][5] trains will be rerouted via the [3] line from Franklin Av to Utica Av or New Lots Av, where they will end. \nThe last stop on some downtown [2] trains will be Chambers St or Rector St (Via [1] line). \n\nListen for train crew announcements to hear how your train will run. \n\nTravel Alternatives:\nFor service between Franklin Av and Flatbush Av, use B44 SBS, B48, or B49 buses making nearby stops.\nIn Manhattan and Brooklyn, consider using [1][3][4][6] trains.",
              "language": "en"
            },
            {
              "text": "<p><strong>What's Happening?</strong></p><p>Emergency teams are responding to someone struck by a train at <strong>Winthrop St</strong>.</p><p style=\"min-height:10px\"></p><p><strong>Service Changes:</strong></p><p>No [2][5] service between Franklin Av and Flatbush Av.</p><p>Flatbush Av-bound [2][5] trains will be rerouted via the [3] line from <strong>Franklin Av</strong> to <strong>Utica Av</strong> or <strong>New Lots Av</strong>, where they will end. </p><p>The last stop on some downtown [2] trains will be <strong>Chambers St</strong> or <strong>Rector St</strong> (Via [1] line). </p><p style=\"min-height:10px\"></p><p>Listen for train crew announcements to hear how your train will run. </p><p style=\"min-height:10px\"></p><p><strong>Travel Alternatives:</strong></p><p>For service between <strong>Franklin Av</strong> and <strong>Flatbush Av</strong>, use <strong>B44 SBS, B48,</strong> or <strong>B49</strong> buses making nearby stops.</p><p>In Manhattan and Brooklyn, consider using [1][3][4][6] trains.  </p>",
              "language": "en-html"
            }
          ]
        },
        "transit_realtime.mercury_alert": {
          "created_at": 1790209673,
          "updated_at": 1790210217,
